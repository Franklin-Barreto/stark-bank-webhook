<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet
            id="001-create-processed-invoice-credit"
            author="franklin.barreto">

        <createTable tableName="processed_invoice_credit">
            <column name="invoice_id" type="varchar(255)">
                <constraints
                        primaryKey="true"
                        nullable="false"
                        primaryKeyName="pk_processed_invoice_credit"/>
            </column>

            <column name="processed_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>

</databaseChangeLog>